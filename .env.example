# Copy this file to `.env` and fill in your key to enable REAL AI responses.
# If GEMINI_API_KEY is left empty, the app still runs in "Demo Mode"
# (simulated responses), so the site is always usable.

# Your Google Gemini API key (server-side only, never exposed to the browser).
GEMINI_API_KEY=

# Optional: override the Gemini model. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional: backend port (defaults to 8787).
PORT=8787
